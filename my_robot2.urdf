<?xml version="1.0"?>
<robot name ="my_robot2">
    <link name ="base_link">
        <visual> 
           <geometry> 
               <cylinder radius ="0.2" length="0.2"/>
           </geometry>
           <origin xyz="0 0 0" rpy="0 0 0"/>
           <material name = "red">
             <color rgba ="1 0 0 1"/>
            </material>
        </visual>

        <collision>
           <geometry>
              <cylinder radius ="0.2" length="0.2"/>
           </geometry>
           <origin xyz= " 0 0 0" rpy="0 0 0"/>
        </collision>

        <inertial>
           <mass value ="2.0"/>
           <origin xyz="0 0 0" rpy="0 0 0"/>
           <inertia ixx="0.01" ixy="0" ixz="0" 
                    iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <link name="link1">
        <visual>
            <geometry>
               <box size="0.15 0.15 1.0"/>
            </geometry>
            <origin xyz= "0 0 0.6" rpy="0 0 0"/>
            <material name ="blue">
              <color rgba ="0 0 1 1"/>
            </material>
        </visual>

        <collision>
           <geometry>
              <box size ="0.15 0.15 1.0" />
           </geometry>
           <origin xyz="0 0 0.6" rpy ="0 0 0"/>
        </collision>

        <inertial>
            <mass value="0.5"/>
            <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.01"/>
            <origin xyz ="0 0 0.6" rpy="0 0 0"/>
        </inertial>

    </link>


    <joint name ="base_link_link1" type ="continuous">
       <parent link="base_link"/>
       <child link="link1"/>
       <origin xyz="0 0 0" rpy="0 0 0"/>
       <axis xyz="0 0 1"/>

       <limit lower ="-3.14"
              upper="3.14"
              effort="10"
              velocity="1.0"/>
    </joint>

    <link name ="link2">
        <visual>
            <geometry>
               <box size =" 0.11 0.11 0.8"/>
            </geometry>
            <origin xyz="0 0 0.4"/>
            <material name ="red">
               <color rgba="1 0 0 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
              <box size = "0.11 0.11 0.8"/>
            </geometry>
            <origin xyz="0 0 0.4"/>
        </collision>

        <inertial>
            <mass value="0.4"/>
            <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
        </inertial>
    </link>

    <joint name="link1_link2" type ="revolute">
        <parent link="link1"/>
        <child link="link2"/>
        <origin xyz="0 0 1.09" rpy="0 0 0"/>
        <axis xyz ="0 1 0"/>
        <limit upper="-2.57"
               lower="2.57"
               effort="10"
               velocity="1.0"/>
    </joint>

    <link name ="link3">
        <visual>
          <geometry>
             <box size="0.09 0.09 0.6"/>
          </geometry>
          <material name = "blue">
             <color rgba = "0 0 1 1"/>
          </material>
          <origin xyz=" 0 0 0.3" rpy="0 0 0"/>
        </visual>
    

        <collision>
            <geometry>
               <box size ="0.09 0.09 0.6"/>
            </geometry>
            <origin xyz="0 0 0.3" rpy=" 0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.15"/>
            <inertia ixx="0.15" ixy="0" ixz="0"
                     iyy="0.15" iyz="0" izz="0.15"/>
        </inertial>
    </link>

    <joint name ="link2_link3" type ="revolute">
        <parent link="link2"/>
        <child link="link3"/>
        <axis xyz="1 0 0" rpy="0 0 0"/>
        <origin xyz="0 0 0.8" rpy="0 0 0"/>
        <limit upper="-1.57"
               lower="1.57"
               effort="10"
               velocity="1.0"/>
    </joint>

    <link name = "link4">
        <visual>
            <geometry>
               <box size="0.08 0.08 0.04"/>
               <origin xyz =" 0 0 0.2" rpy=" 0 0 0"/>
               <material name ="red">
                 <color rgba="1 0 0 1"/>
               </material>
            </geometry>
        </visual>
        
        <collision>
            <origin xyz="0 0 0.2" rpy=" 0 0 0"/>
            <geometry>
               <box size="0.08 0.08 0.04"/>
            </geometry>
        </collision>

        <inertial>
           <origin xyz="0 0 0.2" rpy="0 0 0"/>
           <mass value="0.5"/>
           <inertia ixx="0.12" ixy="0" ixz="0"
                    iyy="0.12" iyz="0" izz="0.12"/>
        </inertial>
    </link>

    <joint name="link3_link4" type="continuous">
        <parent link="link3"/>
        <child link="link4"/>
        <origin xyz="0 0 0.6" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit upper="-1.57"
               lower="1.57"
               effort="0.5"
               velocity="10"/>
    </joint>

    <link name="right_gripper">
        <visual>
            <geometry>
               <box size="0.01 0.09 0.1"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="grey">
                 <color rgba="0.7 0.7 0 1"/>
            </material>
       </visual> 
       <collision>
             <geometry>
                  <box size="0.01 0.09 0.1"/>
             </geometry>
             <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </collision>
    </link> 

    <joint name="link4_right_gripper" type="prismatic">
            <parent link="link4"/>
            <child link="right_gripper"/>
            <origin xyz="-0.02 0 0" rpy="0 0 0"/>
            <axis xyz="0.1 0 0"/>
            <limit lower="0" 
                   upper="0.01" 
                   effort="10" 
                   velocity="0.05"/>
    </joint>
    
    <link name="left_gripper">
        <visual>
            <geometry>
               <box size="0.01 0.09 0.1"/>
            </geometry>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <material name="grey">
                 <color rgba="0.7 0.7 0 1"/>
            </material>
       </visual> 
       <collision>
             <geometry>
                  <box size="0.01 0.09 0.1"/>
             </geometry>
             <origin xyz="0 0 0.1" rpy="0 0 0"/>
        </collision>
    </link> 

    <joint name="link4_left_gripper" type="prismatic">
            <parent link="link4"/>
            <child link="left_gripper"/>
            <origin xyz="0.02 0 0" rpy="0 0 0"/>
            <axis xyz="-0.1 0 0"/>
            <limit lower="0" 
                   upper="0.01" 
                   effort="10" 
                   velocity="0.05"/>
    </joint>


</robot>